<EmailLayout
    Title="Kod do resetowania hasła"
    Heading="Resetowanie hasła"
    FooterNote="Kod jest ważny przez ograniczony czas. Jeśli nie prosiłeś o reset hasła, zignoruj tę wiadomość.">
    <p style="margin: 0 0 16px; font-size: 16px; line-height: 24px; color: #374151;">
        Twój jednorazowy kod do zresetowania hasła w serwisie Prezentownik:
    </p>
    <div style="text-align: center; margin: 24px 0;">
        <span style="display: inline-block; font-size: 28px; font-weight: 700; letter-spacing: 6px; padding: 12px 24px; background-color: #F3F4F6; border-radius: 8px; color: #111827;">
            @ResetCode
        </span>
    </div>
</EmailLayout>

@code {
    [Parameter]
    public required string ResetCode { get; set; }
}
